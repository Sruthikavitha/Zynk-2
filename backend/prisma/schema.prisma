datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  CHEF
  ADMIN
  DELIVERY_PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PREPARED
  OUT_FOR_DELIVERY
  DELIVERED
  SKIPPED
  CANCELLED
}

enum ActionType {
  SKIP
  SWAP
  ADDRESS_CHANGE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  phone        String
  passwordHash String
  role         Role        @default(CUSTOMER)
  status       UserStatus  @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  chefProfile     Chef?
  deliveryPartner DeliveryPartner?
  subscriptions   Subscription[]
  addresses       Address[]
  orders          Order[]
  mealActions     MealAction[]
  payments        Payment[]
  notifications   Notification[]
}

model Chef {
  id             String         @id @default(uuid())
  userId         String         @unique
  kitchenName    String
  kitchenType    String         // Home Kitchen, Cloud Kitchen
  location       String
  district       String         @default("Coimbatore")
  city           String         @default("Coimbatore")
  area           String?
  address        String?
  latitude       Float?
  longitude      Float?
  cuisine        String?
  description    String?
  rating         Float?         @default(4.8)
  isActive       Boolean        @default(true)
  serviceAreas   String?        // JSON array of serviceable areas
  fssaiNumber    String?
  approvalStatus ApprovalStatus @default(PENDING)
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  meals            Meal[]
  orders           Order[]
  chefDailyReports ChefDailyReport[]
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  description  String
  price        Float
  durationDays Int      @default(7)
  mealOptions  String   // JSON string or summary of options
  features     String   // JSON string of features list
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id              String             @id @default(uuid())
  userId          String
  planId          String
  startDate       DateTime
  endDate         DateTime
  status          SubscriptionStatus @default(ACTIVE)
  paymentId       String?
  razorpayOrderId String?
  amount          Float
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])
  orders Order[]
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  label     String   // Home, College, Work, Other
  street    String
  city      String
  state     String
  postalCode String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders             Order[]      @relation("DeliveryAddress")
  originalAddressFor MealAction[] @relation("OriginalAddress")
  newAddressFor      MealAction[] @relation("NewAddress")
}

model Meal {
  id          String   @id @default(uuid())
  chefId      String
  name        String
  description String
  mealType    MealType
  imageUrl    String
  price       Float    @default(0.0)
  isAvailable Boolean  @default(true)
  maxQuantity Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chef            Chef         @relation(fields: [chefId], references: [id], onDelete: Cascade)
  orders          Order[]
  originalMealFor MealAction[] @relation("OriginalMeal")
  newMealFor      MealAction[] @relation("NewMeal")
}

model Order {
  id                String      @id @default(uuid())
  userId            String
  chefId            String
  subscriptionId    String?
  mealId            String
  deliveryDate      DateTime
  mealType          MealType
  status            OrderStatus @default(CONFIRMED)
  deliveryAddressId String
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chef            Chef          @relation(fields: [chefId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  meal            Meal          @relation(fields: [mealId], references: [id])
  deliveryAddress Address       @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])

  mealActions MealAction[]
  delivery    Delivery?
}

model MealAction {
  id                String     @id @default(uuid())
  orderId           String
  userId            String
  actionType        ActionType
  originalMealId    String?
  newMealId         String?
  originalAddressId String?
  newAddressId      String?
  createdAt         DateTime   @default(now())

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalMeal    Meal?    @relation("OriginalMeal", fields: [originalMealId], references: [id])
  newMeal         Meal?    @relation("NewMeal", fields: [newMealId], references: [id])
  originalAddress Address? @relation("OriginalAddress", fields: [originalAddressId], references: [id])
  newAddress      Address? @relation("NewAddress", fields: [newAddressId], references: [id])
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  subscriptionId    String?
  razorpayOrderId   String
  razorpayPaymentId String?
  amount            Float
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id                   String            @id @default(uuid())
  reportDate           DateTime          @unique
  totalMeals           Int               @default(0)
  totalSkipped         Int               @default(0)
  totalSwapped         Int               @default(0)
  totalAddressChanges  Int               @default(0)
  createdAt            DateTime          @default(now())

  chefReports ChefDailyReport[]
}

model ChefDailyReport {
  id               String   @id @default(uuid())
  dailyReportId    String
  chefId           String
  breakfastCount   Int      @default(0)
  lunchCount       Int      @default(0)
  dinnerCount      Int      @default(0)
  totalMeals       Int      @default(0)
  deliveryGrouping String   // JSON string of location-wise counts
  createdAt        DateTime @default(now())

  dailyReport DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  chef        Chef        @relation(fields: [chefId], references: [id], onDelete: Cascade)
}

model DeliveryPartner {
  id          String   @id @default(uuid())
  userId      String   @unique
  vehicleType String   // Bike, Scooter, Car
  status      String   @default("AVAILABLE") // AVAILABLE, BUSY, OFFLINE
  location    String   @default("Coimbatore")
  createdAt   DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
}

model Delivery {
  id                String         @id @default(uuid())
  orderId           String         @unique
  deliveryPartnerId String?
  status            DeliveryStatus @default(ASSIGNED)
  pickupTime        DateTime?
  deliveryTime      DateTime?
  createdAt         DateTime       @default(now())

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartner DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
